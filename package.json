{
  "name": "gemino",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Hide, collapse, minimize, or blur Google's AI Overview, AI Mode, and Gemini prompts.",
  "scripts": {
    "rules": "tsx scripts/build-rules.ts",
    "dev": "npm run rules && vite",
    "build": "npm run rules && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fetch-domains": "tsx scripts/fetch-google-domains.ts",
    "package": "npm run build && tsx scripts/package.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
